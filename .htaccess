# GetJobReady production entrypoint
# Hostinger/LiteSpeed may deploy the repository root while the Vite app lives in dist/.
# Always serve the verified production bundle at the site root.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^$ /dist/index.html [END]
</IfModule>

# PDF.js uses an ES module worker. LiteSpeed/Apache can otherwise serve .mjs
# as text/plain, which browsers reject for module execution.
<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType application/javascript .js
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|index\.src\.html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
