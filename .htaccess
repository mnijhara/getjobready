# Hostinger Apache configuration for SPA, Cache Control, and Social Crawler Access

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"

  # HTML files MUST NEVER be cached to prevent stale JS bundle hash 404s
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static hashed assets can be cached safely
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webmanifest|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Correct MIME Types for application assets. Module scripts are rejected by browsers
# when Apache falls back to text/plain, so declare both JS extensions explicitly.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/javascript .mjs
  AddType image/svg+xml .svg
  AddType image/png .png
  AddType image/x-icon .ico .cur
  AddType application/manifest+json .webmanifest
</IfModule>

# Single Page App Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
